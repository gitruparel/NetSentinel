<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_navy"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Risk Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="@color/alert_red">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/tv_detail_score"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evil Twin AP Rogue Clone"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_detail_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="INCIDENT ID: INC-8942 | AUDIT-042"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_red"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="88 / 100 RISK"
                    android:textColor="@color/alert_red"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- AI Analysis Box -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:strokeColor="@color/cyber_cyan">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 NetTrust AI Security Analysis"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_ai_analysis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="NetTrust AI Engine detected duplicate SSID 'CyberCorp_5G_Secured' broadcasting with unauthorized OUI vendor bytes (Hak5). Beacon frames confirm deauth injection sequence. Recommended action: Disconnect immediately and quarantine AP."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Incident Timeline Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incident Timeline"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_timeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="6dp"
                    android:text="• [10:41:50 AM] Baseline scan executed\n• [10:42:01 AM] Duplicate SSID detected with mismatched MAC vendor\n• [10:42:04 AM] DNS resolution redirected to 198.51.100.42\n• [10:42:05 AM] AP quarantined &amp; incident evidence logged"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Network Specs & Evidence Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Specs &amp; Forensics"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_specs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Target BSSID: DE:AD:BE:EF:42:01\nVendor: Hak5 Pineapple NANO\nSecurity: WPA2-Personal (Downgraded)\nFrequency: 5240 MHz (Channel 48)\nGPS Location: 37.7749° N, 122.4194° W"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Evidence Photo Container -->
                <RelativeLayout
                    android:id="@+id/container_evidence_photo"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/surface_card_elevated">

                    <ImageView
                        android:id="@+id/img_evidence_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_evidence_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="[SPECTRUM_CAPTURE_EVIDENCE_042.PNG]"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="12sp" />

                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_capture_photo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Capture Camera Photo Evidence"
                    android:textColor="@color/cyber_cyan"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/cyber_cyan" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Export PDF Report Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_report"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="72dp"
            android:backgroundTint="@color/neon_green"
            android:text="@string/btn_export_report"
            android:textColor="@color/bg_dark_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_export"
            app:iconTint="@color/bg_dark_navy" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
