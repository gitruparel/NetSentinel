<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_navy"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Application Preferences Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Preferences"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Dark Mode Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="true"
                    android:text="Dark Cyber Theme"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/neon_green"
                    app:trackTint="@color/neon_green_alpha20" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_glow" />

                <!-- Threat Notifications Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Real-time Threat Push Notifications"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/neon_green"
                    app:trackTint="@color/neon_green_alpha20" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_glow" />

                <!-- Community Threat Feed Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_community_feed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Community Threat Intelligence Feed"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/cyber_cyan"
                    app:trackTint="@color/cyber_cyan_alpha20" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Developer Mode Shortcut -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_dev_sim"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Open Developer Attack Simulation Sandbox"
            android:textColor="@color/cyber_cyan"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_sim_dev"
            app:iconTint="@color/cyber_cyan"
            app:strokeColor="@color/cyber_cyan" />

        <!-- Local Database (Room SQLite) Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Database (Firebase Firestore &amp; Room Local DB)"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_db_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Database: Firebase Firestore + Room Offline Cache\nStatus: Syncing &amp; Persistence Ready\nIncidents: Loading... | Audits: Loading..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_db"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Reset to Defaults"
                        android:textColor="@color/neon_green"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/neon_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_db"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Clear Database"
                        android:textColor="@color/alert_red"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/alert_red" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- About NetSentinel Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="72dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About NetSentinel Platform"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_version"
                    android:textColor="@color/neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="NetSentinel is an enterprise mobile network security auditor powered by the NetTrust Engine. Built for mobile security professionals, threat hunters, and network administrators."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
